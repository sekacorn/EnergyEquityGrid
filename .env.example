# Database
POSTGRES_DB=energyequitygrid
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Shared backend settings
ALLOWED_ORIGINS=http://localhost:3000

# NIST IA-5: Use a cryptographically strong random secret (min 64 chars).
# Generate with: openssl rand -base64 64
JWT_SECRET=replace-with-a-long-random-secret

# NIST AC-12: Session timeout — access token (4h default), refresh token (24h default)
JWT_EXPIRATION=14400000
JWT_REFRESH_EXPIRATION=86400000
MFA_ISSUER=EnergyEquityGrid

# Frontend service URLs (used by Vite at build time)
VITE_API_AI=http://localhost:8081
VITE_API_AUTH=http://localhost:8081
VITE_API_INTEGRATOR=http://localhost:8081
VITE_API_PREDICTOR=http://localhost:8083
VITE_API_LLM=http://localhost:8084
VITE_API_SESSION=http://localhost:8082
VITE_WS_COLLAB=ws://localhost:8081/ws/collaborate

# Backend downstream AI routing
AI_PREDICTOR_URL=http://ai-service:8083
AI_LLM_URL=http://llm-service:8084

# Optional SSO providers
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
AZURE_CLIENT_ID=your-azure-client-id
AZURE_CLIENT_SECRET=your-azure-client-secret
OKTA_CLIENT_ID=your-okta-client-id
OKTA_CLIENT_SECRET=your-okta-client-secret
